<?xml version="1.0" encoding="utf-8"?>
<!-- Phần CHUNG của hai app (P30): mạng, tự cập nhật, tải tệp. Màn hình + quyền riêng của từng app nằm ở
     src/thuNgan/AndroidManifest.xml (POS, cầu in, Quản trị) và src/quanLy/AndroidManifest.xml (app Quản lý). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Tự cập nhật (24-02): mở màn cài của Android cho tệp APK đã tải + kiểm sha256. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Xuất Excel từ trang quản trị (P30): Android 8–9 cần quyền này để lưu vào thư mục Tải xuống; Android 10+ không cần. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/ten_app"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="false"
        android:theme="@style/Theme.TechMenu"
        android:networkSecurityConfig="@xml/network_security_config">
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.cap-nhat"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/duong_dan_cap_nhat" />
        </provider>
    </application>
</manifest>
