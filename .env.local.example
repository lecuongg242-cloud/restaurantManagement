# Supabase — sao chép sang .env.local và điền giá trị thật (KHÔNG commit .env.local).
# Lấy tại: Supabase Dashboard → Project Settings → API.

# Public (browser + server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — KHÔNG để lộ ra client. Bỏ qua RLS; chỉ dùng trong context server tin cậy.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-only (QD-009) — pepper bí mật để suy dẫn mật khẩu Supabase từ PIN nhân viên.
# Tạo chuỗi ngẫu nhiên dài (vd: openssl rand -hex 32). ĐỔI pepper = mọi PIN cũ hết đăng nhập
# được (phải reset PIN). KHÔNG commit giá trị thật.
STAFF_PIN_PEPPER=your-long-random-pepper

# ── In phiếu bếp (V1.x, PRINT-01) ─────────────────────────────────────────────
# bridge = phiếu bếp vào hàng đợi print_jobs cho cầu in ESC/POS cục bộ in tự động.
# Bỏ trống/browser = giữ cách cũ (bấm in → hộp thoại trình duyệt).
NEXT_PUBLIC_PRINT_MODE=browser

# ── Cầu in cục bộ (scripts/print-bridge.mjs — CHỈ chạy trên máy tại quán) ──────
# Máy in bếp nối LAN, in raw ESC/POS qua cổng 9100. PRINTER_CHARS: 80mm=48, 58mm=32.
PRINTER_HOST=192.168.1.234
PRINTER_PORT=9100
PRINTER_CHARS=48
POLL_MS=2000
# Bỏ qua phiếu tồn cũ hơn N phút — cầu in tắt cả đêm rồi bật lại không tuôn phiếu hôm qua.
MAX_JOB_AGE_MIN=30
# Cầu in chỉ in phiếu của ĐÚNG quán này (slug trong URL /r/<slug>).
# Tài khoản thiết bị của cầu in — cấp ở /super → hàng nhà hàng → "Tài khoản cầu in".
# Máy tại quán TUYỆT ĐỐI KHÔNG giữ SUPABASE_SERVICE_ROLE_KEY (QD-012 §1): khóa đó bỏ qua RLS,
# mất máy là lộ dữ liệu của MỌI nhà hàng. Tenant suy từ token, không cấu hình tay.
PRINT_BRIDGE_EMAIL=print-your-restaurant-slug@bridge.local
PRINT_BRIDGE_PASSWORD=
